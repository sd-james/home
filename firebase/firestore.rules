rules_version = '2';

// Households and members are only changed by Cloud Functions (functions/src/index.ts).
// The app reads its household, and reads/writes tasks and its own push tokens.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isMember(householdId) {
      return signedIn()
        && request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberIds;
    }

    function validTask(task) {
      return task.title is string && task.title.size() > 0 && task.title.size() <= 200
        && (!('notes' in task) || task.notes == null || (task.notes is string && task.notes.size() <= 2000))
        && task.done is bool
        && task.reminderPending is bool
        && (task.remindAt == null || task.remindAt is timestamp)
        && task.repeat in ['none', 'daily', 'weekly', 'monthly'];
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    match /households/{householdId} {
      allow read: if isMember(householdId);

      match /tasks/{taskId} {
        allow read, delete: if isMember(householdId);
        allow create: if isMember(householdId) && validTask(request.resource.data)
          && request.resource.data.createdBy == request.auth.uid;
        allow update: if isMember(householdId) && validTask(request.resource.data)
          && request.resource.data.createdBy == resource.data.createdBy;
      }

      match /devices/{deviceId} {
        allow read: if isMember(householdId);
        allow create, update: if isMember(householdId) && request.resource.data.uid == request.auth.uid
          && request.resource.data.token is string;
        allow delete: if isMember(householdId) && resource.data.uid == request.auth.uid;
      }
    }
  }
}
